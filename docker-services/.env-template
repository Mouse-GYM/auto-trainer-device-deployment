# Docker Compose project name (prefix)
# Typical value: autotrainer
AUTOTRAINER_COMPOSE_NAME=autotrainer

# Output location for container logs.
# Typical value: /var/log/autotrainer
AUTOTRAINER_LOG_VOLUME=/var/log/autotrainer

# Device identifier for notifications and other messaging.
# Typical value: agx001
AUTOTRAINER_DEVICE_ID=

# IANA time zone of the api container. Must match the zone the device's event producer writes its local times in.
# Leave blank for the default, America/Denver.
AUTOTRAINER_TZ=

# AWS region of the lab's AWS resources (SNS topic, Cognito user pool).
# Typical value: us-east-2
AUTOTRAINER_AWS_REGION=us-east-2

# AWS access key for the api. One IAM principal serves every AWS service the api calls (SNS today).
# These are separate from the cert manager's AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY below.
# Leave blank if not using emergency notifications.
AUTOTRAINER_AWS_ACCESS_KEY_ID=
AUTOTRAINER_AWS_ACCESS_KEY=

# The AWS SNS topic arn to enable emergency stop/resume notifications.
# Leave blank if not using emergency notifications.
AUTOTRAINER_AWS_SNS_TOPIC_ARN=

# Cognito user pool and app client the management dashboard signs in with.
# Required for any dashboard action that changes the device (notes, commands); reads work without them.
# Typical values: us-east-2_rPVvjcKHK / 3tqg9ucnpcavsl227oi04vb0kt
AUTOTRAINER_AWS_COGNITO_USER_POOL_ID=
AUTOTRAINER_AWS_COGNITO_CLIENT_ID=

# Domain name for the dashboard TLS certificate (issued via Let's Encrypt).
# A Route 53 hosted zone and A record must exist for this domain.
# Example: dashboard.yourdomain.com
CERT_DOMAIN=

# AWS credentials for Route 53 DNS-01 certificate validation.
# Use an IAM user scoped to ChangeResourceRecordSets on the hosted zone.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
